# Kopieren nach .env und Werte anpassen (.env wird nicht committet)
ACCESS_TOKEN=dein-langer-zufaelliger-code

# Nur für client.js (auf dem Mac):
SERVER_URL=https://DEIN-DIENST.onrender.com
PLAYER_SIDE=left   # left | right | center

# Nur auf dem Mac mit Keynote UND den VJ-Playern: aktiviert die Handy-Buttons "VJ vorne" / "Keynote vorne".
#CAN_FOCUS=1
#VJ_APP_NAMES=VJ Player,Electron   # Prozessnamen der Player (installiert: "VJ Player", npm start: "Electron")
#VJ_HIDE=0                         # Standard: Player werden bei "Keynote vorne" ausgeblendet; 0 = nicht
